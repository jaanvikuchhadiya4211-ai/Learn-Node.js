<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <table border="1" width="500px">
        <% items.forEach(item => { %>
        <tr>
            <td><%= item.name _%></td>
            <td><%= item.age _%></td>
            <td><%= item.city _%></td>
        </tr>
        <% }); %>

    </table>

    <!-- <% if(message) {%>
        <p><%= message%></p>
    <% } else { %>
        <span>there is no message</span>
    <%} %> -->
</body>
</html>